<?xml version="1.0" encoding="UTF-8"?>
<!--
  Log4j 2 configuration — suite logging standard (uch-env/docs/Logging_Standard.md).
  Migrated verbatim from the former Log4j-1.x log4j.properties: same console appender, same
  conversion pattern, same per-logger levels (root WARN; app package net.uch raised to INFO).
  slf4j (HikariCP + app code), Commons Logging (Jasper), Spring (spring-jcl) and Hibernate
  (JBoss Logging) all converge on this single backend.
-->
<Configuration status="WARN">
    <Appenders>
        <Console name="STDOUT" target="SYSTEM_OUT">
            <!-- Alternate short pattern kept from the old file: %d{HH:mm:ss,SSS} [%-5p] %-5l - %m%n -->
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss,SSS} [%-5p] [%t] %-5l - %m%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <Logger name="org.apache.commons" level="INFO"/>
        <Logger name="org.richfaces.component" level="INFO"/>
        <Logger name="org.ajax4jsf" level="INFO"/>
        <Logger name="net.sf.jasperreports.engine.fill" level="INFO"/>
        <Logger name="org.springframework" level="INFO"/>
        <Logger name="org.hibernate" level="INFO"/>
        <Logger name="org.hibernate.cfg" level="WARN"/>
        <!-- SQL-debug toggles kept from the old file; raise when diagnosing queries:
             <Logger name="org.hibernate.SQL" level="DEBUG"/>
             <Logger name="org.hibernate.type.descriptor.sql.BasicBinder" level="TRACE"/> -->
        <Logger name="com.zaxxer.hikari" level="INFO"/>
        <Logger name="net.uch" level="INFO"/>
        <Root level="WARN">
            <AppenderRef ref="STDOUT"/>
        </Root>
    </Loggers>
</Configuration>
