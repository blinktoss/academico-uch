<beans>

    <!-- New service layer config (XSD-namespace style, tx:annotation-driven, component-scan) -
         kept in its own file since this one's DTD-based <beans> root can't host it. -->
    <import resource="applicationContext-services.xml"/>

    <!-- ========================= RESOURCE DEFINITIONS ========================= -->
    <bean id="helper" class="net.uch.common.SystemHelper"/>
    <bean id="printer" class="net.uch.common.Print">
        <property name="dataSource" ref="dataSource"/>
    </bean>

    <!-- Configurer that replaces ${...} placeholders with values from a properties file -->
    <!-- (in this case, JDBC-related settings for the dataSource definition below) -->
    <bean id="propertyConfigurer" class="org.springframework.context.support.PropertySourcesPlaceholderConfigurer">
        <property name="location" value="/WEB-INF/hibernate.properties"/>
    </bean>

    <!-- HikariCP connection pool (Track-2 suite standard, #62). Spring owns this DataSource and
         injects it into the SessionFactory and the Jasper 'printer' bean; Hibernate does not use
         its own connection provider. Connection settings reuse the same ${jdbc.*} placeholders as
         before, so the env-var path (JDBC_URL / JDBC_USER / JDBC_PASSWORD) is unchanged. -->
    <bean id="dataSource" class="com.zaxxer.hikari.HikariDataSource" destroy-method="close">
        <property name="driverClassName" value="${jdbc.driverClassName}"/>
        <property name="jdbcUrl" value="${jdbc.url}"/>
        <property name="username" value="${jdbc.username}"/>
        <property name="password" value="${jdbc.password}"/>

        <property name="poolName" value="uch-academico-pool"/>
        <!-- Fixed pool (minimumIdle == maximumPoolSize) avoids churn; sized for ~50 concurrent
             administrative users and a safe share of MySQL 5.6's connection budget across the UCH
             suite. Down from c3p0's 10/150, which was never fully used and oversubscribed the
             shared database. -->
        <property name="maximumPoolSize" value="25"/>
        <property name="minimumIdle" value="25"/>

        <!-- HikariCP does not pool statements, which removes c3p0's asynchronous statement-close
             "APPARENT DEADLOCK" class entirely. Prepared-statement caching is delegated to the
             MySQL driver (HikariCP's documented recommendation), preserving the intent of c3p0's
             old per-connection statement cache without its failure mode. -->
        <property name="dataSourceProperties">
            <props>
                <prop key="cachePrepStmts">true</prop>
                <prop key="prepStmtCacheSize">250</prop>
                <prop key="prepStmtCacheSqlLimit">2048</prop>
            </props>
        </property>

        <!-- Connection validity is checked via JDBC4 Connection.isValid() on checkout (no test
             query needed for Connector/J 8), so c3p0's idleConnectionTestPeriod is gone. A leaked
             connection (a missing try/finally) is NOT force-reclaimed mid-transaction; Hikari
             retires it at maxLifetime (default 30 min, safely under MySQL wait_timeout). To hunt a
             suspected leak, set leakDetectionThreshold (ms) to log the offending stack trace. -->
    </bean>

