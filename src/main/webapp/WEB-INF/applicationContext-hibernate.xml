        <property name="transactionAttributes">
            <props>
                <prop key="get*">PROPAGATION_REQUIRED,readOnly</prop>
                <prop key="find*">PROPAGATION_REQUIRED,readOnly</prop>
                <prop key="load*">PROPAGATION_REQUIRED,readOnly</prop>
                <prop key="store*">PROPAGATION_REQUIRED</prop>
                <prop key="add*">PROPAGATION_REQUIRED</prop>
                <prop key="*">PROPAGATION_REQUIRED</prop>
                <!-- None of HSActaDAO's actual method names (seleccionar*/saveOrUpdateActa/
                     insertarActaDetalles/eliminarActa/reemplazarActaSustitutoria) matched any
                     rule above, so those calls ran with no Spring-managed transaction at all. -->
                <prop key="seleccionar*">PROPAGATION_REQUIRED,readOnly</prop>
                <prop key="saveOrUpdateActa">PROPAGATION_REQUIRED</prop>
                <prop key="insertarActaDetalles">PROPAGATION_REQUIRED</prop>
                <prop key="eliminarActa">PROPAGATION_REQUIRED</prop>
                <prop key="reemplazarActaSustitutoria">PROPAGATION_REQUIRED</prop>
            </props>
        </property>
    </bean>

